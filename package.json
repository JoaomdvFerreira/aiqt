{
  "name": "aiqt",
  "version": "0.13.1",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@7.33.5",
  "bin": {
    "aiqt": "./dist/index.js"
  },
  "files": [
    "dist"
