    "@types/node": "^22.5.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "6.4.3",
    "vitest": "^3.2.7"
  }
}
